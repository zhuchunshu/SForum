{
  "name": "@sforum/web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file=../../.env scripts/dev-theme-runtime.mjs",
    "dev:plain": "nuxt dev --host 0.0.0.0 --dotenv ../../.env",
    "build": "NUXT_BUILD_DIR=${NUXT_BUILD_DIR:-.nuxt-build} nuxt build",
    "preview": "HOST=0.0.0.0 bun --env-file=../../.env scripts/preview.mjs",
    "theme:runtime": "node scripts/runtime.mjs",
    "typecheck": "NUXT_BUILD_DIR=${NUXT_BUILD_DIR:-.nuxt-typecheck} nuxt prepare && vue-tsc --noEmit -p ${NUXT_BUILD_DIR:-.nuxt-typecheck}/tsconfig.json"
  },
  "dependencies": {
    "@sforum/admin-sdk": "workspace:*",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/tabler": "^1.2.35",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/seo": "^5.3.2",
    "@tiptap/extension-character-count": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "altcha": "^3.1.0",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "nuxt": "^4.4.8",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.6"
  }
}
