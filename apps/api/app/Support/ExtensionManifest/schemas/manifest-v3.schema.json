{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sforum.dev/schemas/extensions/manifest-v3.schema.json",
  "title": "SForum Extension Manifest V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "description", "url", "author", "version", "type", "sforumVersion"],
  "properties": {
    "manifestVersion": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "$ref": "#/$defs/nonEmpty" },
    "description": { "$ref": "#/$defs/nonEmpty" },
    "url": { "type": "string", "format": "uri" },
    "author": { "$ref": "#/$defs/author" },
    "version": { "type": "string", "format": "semver" },
    "type": { "enum": ["plugin", "theme"] },
    "sforumVersion": { "$ref": "#/$defs/nonEmpty" },
    "langs": {
      "type": ["object", "null"],
      "additionalProperties": { "$ref": "#/$defs/locale" }
    },
    "permissions": { "$ref": "#/$defs/stringArray" },
    "capabilities": { "$ref": "#/$defs/stringArray" },
    "requiresFeatures": { "$ref": "#/$defs/stringArray" },
    "settings": {},
    "migrations": { "$ref": "#/$defs/migrations" },
    "backend": { "$ref": "#/$defs/backend" },
    "admin": { "$ref": "#/$defs/admin" },
    "adminPages": { "$ref": "#/$defs/adminPages" },
    "routes": { "$ref": "#/$defs/routes" },
    "hooks": { "$ref": "#/$defs/hooks" },
    "events": { "$ref": "#/$defs/events" },
    "jobs": { "$ref": "#/$defs/jobs" },
    "providers": { "$ref": "#/$defs/providers" },
    "contributions": { "$ref": "#/$defs/contributions" },
    "guards": { "$ref": "#/$defs/guards" },
    "schedules": { "$ref": "#/$defs/schedules" },
    "components": { "$ref": "#/$defs/components" },
    "templates": { "$ref": "#/$defs/templates" },
    "assets": { "$ref": "#/$defs/assets" },
    "content": { "$ref": "#/$defs/content" },
    "database": { "$ref": "#/$defs/database" },
    "cache": { "$ref": "#/$defs/cache" },
    "services": { "$ref": "#/$defs/services" },
    "commands": { "$ref": "#/$defs/commands" },
    "adminSurfaces": { "$ref": "#/$defs/adminSurfaces" },
    "queries": { "$ref": "#/$defs/queries" },
    "identity": { "$ref": "#/$defs/identity" },
    "permissionDefinitions": { "$ref": "#/$defs/permissionDefinitions" },
    "media": { "$ref": "#/$defs/media" },
    "navigation": { "$ref": "#/$defs/navigation" },
    "regions": { "$ref": "#/$defs/regions" },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "openapi": { "$ref": "#/$defs/openapi" },
    "packageFiles": { "$ref": "#/$defs/packageFiles" },
    "includes": { "$ref": "#/$defs/includes" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,80}$" },
    "contract": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^/].*$" },
    "schemaRef": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        { "pattern": "^[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$" },
        { "pattern": "^[^/].*\\.json$" }
      ]
    },
    "stringArray": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "url": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "author": { "$ref": "#/$defs/author" }
      }
    },
    "versioned": {
      "type": "object",
      "required": ["id", "contractVersion"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "contractVersion": { "$ref": "#/$defs/contract" }
      }
    },
    "backend": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string" },
        "rpc": { "type": "string" },
        "protocolVersion": { "type": "integer", "minimum": 0, "maximum": 2 },
        "digest": { "type": "string" },
        "hostApiVersion": { "type": "string" }
      }
    },
    "admin": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "entry": { "type": "string" },
        "pages": { "$ref": "#/$defs/adminPages" }
      }
    },
    "adminPages": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "label"],
        "properties": {
          "path": { "type": "string" },
          "label": { "$ref": "#/$defs/nonEmpty" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "view": { "type": "string" },
          "menu": { "type": "boolean" },
          "order": { "type": "integer" },
          "permission": { "type": "string" }
        }
      }
    },
    "migrations": {
      "type": ["array", "null"],
      "items": {
        "allOf": [
          { "$ref": "#/$defs/versioned" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "contractVersion", "path", "digest", "transaction"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "contractVersion": { "$ref": "#/$defs/contract" },
              "path": { "$ref": "#/$defs/path" },
              "digest": { "$ref": "#/$defs/digest" },
              "transaction": { "enum": ["required", "forbidden", "auto"] }
            }
          }
        ]
      }
    },
    "routes": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "action", "path", "methods", "guard", "fallback", "mode"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "action": { "enum": ["add", "alias", "redirect", "rewrite", "before", "after", "filter", "wrap", "replace", "global_middleware"] },
          "targetId": { "$ref": "#/$defs/id" },
          "path": { "type": "string" },
          "methods": { "$ref": "#/$defs/stringArray" },
          "access": { "type": "string" },
          "permission": { "type": "string" },
          "guard": { "$ref": "#/$defs/id" },
          "priority": { "type": "integer" },
          "fallback": { "enum": ["closed", "not_found", "readonly_core"] },
          "mode": { "enum": ["http", "sse", "websocket", "stream", "multipart"] },
          "destination": { "type": "string" },
          "handler": { "type": "string" },
          "requestSchema": { "type": "string" },
          "responseSchema": { "type": "string" },
          "timeoutMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "guards": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "kind", "entry", "digest"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "kind": { "enum": ["custom", "raw_request"] },
          "entry": { "$ref": "#/$defs/path" },
          "digest": { "$ref": "#/$defs/digest" },
          "permissions": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "hooks": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "name", "kind", "inputSchema"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "name": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["action", "filter", "observe"] },
          "targetId": { "$ref": "#/$defs/id" },
          "handler": { "$ref": "#/$defs/nonEmpty" },
          "inputSchema": { "$ref": "#/$defs/schemaRef" },
          "resultSchema": { "type": "string" },
          "priority": { "type": "integer" },
          "execution": { "enum": ["sync", "async"] },
          "failurePolicy": { "enum": ["fail_closed", "fail_open"] },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "mutableFields": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "events": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "name", "kind", "handler", "inputSchema"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "name": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["observe", "filter"] },
          "handler": { "$ref": "#/$defs/nonEmpty" },
          "inputSchema": { "$ref": "#/$defs/schemaRef" },
          "resultSchema": { "type": "string" },
          "priority": { "type": "integer" },
          "timeoutMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "jobs": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "name", "handler", "payloadSchema", "retryPolicy"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "name": { "$ref": "#/$defs/id" },
          "handler": { "$ref": "#/$defs/nonEmpty" },
          "payloadSchema": { "$ref": "#/$defs/schemaRef" },
          "retryPolicy": { "enum": ["none", "bounded", "exponential"] },
          "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 25 },
          "retryDelaySeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
          "concurrencyLimit": { "type": "integer", "minimum": 1, "maximum": 16 }
        }
      }
    },
    "schedules": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "jobId", "cron"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "jobId": { "$ref": "#/$defs/id" },
          "cron": { "$ref": "#/$defs/nonEmpty" },
          "timezone": { "type": "string" }
        }
      }
    },
    "providers": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "slot", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "slot": { "$ref": "#/$defs/id" },
          "targetId": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/nonEmpty" },
          "handler": { "$ref": "#/$defs/nonEmpty" },
          "requestSchema": { "type": "string" },
          "responseSchema": { "type": "string" },
          "fallback": { "enum": ["next", "closed"] },
          "priority": { "type": "integer" },
          "timeoutMs": { "type": "integer", "minimum": 0 }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "required": ["targetId"] },
                { "required": ["requestSchema"] },
                { "required": ["responseSchema"] }
              ]
            },
            "then": {
              "required": ["requestSchema", "responseSchema"],
              "properties": {
                "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 5000 }
              }
            },
            "else": { "required": ["handler"] }
          },
          {
            "if": { "required": ["targetId"] },
            "then": { "required": ["handler"] }
          }
        ]
      }
    },
    "contributions": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "id"],
        "properties": {
          "point": { "$ref": "#/$defs/id" },
          "id": { "$ref": "#/$defs/id" },
          "order": { "type": "integer" },
          "label": { "type": "object", "additionalProperties": { "type": "string" } },
          "icon": { "type": "string" },
          "payload": {}
        }
      }
    },
    "components": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "action"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "action": { "enum": ["add", "before", "after", "wrap", "replace", "hide", "filter_props", "filter_result"] },
          "targetId": { "$ref": "#/$defs/id" },
          "targetContractVersion": { "$ref": "#/$defs/contract" },
          "priority": { "type": "integer" },
          "ssrTemplate": { "type": "string" },
          "l2Component": { "type": "string" },
          "propsSchema": { "type": "string" },
          "resultSchema": { "type": "string" },
          "themeOverrideKey": { "type": "string" }
        },
        "allOf": [
          { "if": { "required": ["targetId"] }, "then": { "required": ["targetContractVersion"] } },
          { "if": { "required": ["targetContractVersion"] }, "then": { "required": ["targetId"] } }
        ]
      }
    },
    "templates": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "action", "path", "digest", "viewModelSchema"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "action": { "enum": ["add", "replace"] },
          "targetId": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/path" },
          "digest": { "$ref": "#/$defs/digest" },
          "viewModelSchema": { "$ref": "#/$defs/schemaRef" },
          "themeOverrideKey": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "contractVersion", "type", "path", "digest"],
        "properties": {
          "handle": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "type": { "enum": ["script", "style"] },
          "path": { "$ref": "#/$defs/path" },
          "digest": { "$ref": "#/$defs/digest" },
          "dependencies": { "$ref": "#/$defs/stringArray" },
          "scope": { "$ref": "#/$defs/stringArray" },
          "module": { "type": "boolean" },
          "loading": { "enum": ["", "blocking", "defer", "async", "preload"] },
          "integrity": { "type": "string" },
          "csp": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "content": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "kind", "schema"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "kind": { "enum": ["block", "shortcode", "embed", "node", "mark", "render_filter", "sanitizer"] },
          "handler": { "type": "string" },
          "schema": { "$ref": "#/$defs/schemaRef" },
          "renderer": { "type": "string" },
          "migration": { "type": "string" }
        }
      }
    },
    "database": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["contractVersion", "backup", "retention"],
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["authority"], "not": { "required": ["grants"] } },
        { "type": "object", "required": ["grants"], "not": { "required": ["authority"] } }
      ],
      "properties": {
        "contractVersion": { "$ref": "#/$defs/contract" },
        "authority": { "enum": ["own_schema", "core_views", "host_commands", "raw_core", "kernel"] },
        "grants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["own_schema", "core_views", "host_commands", "raw_core", "kernel"] }
        },
        "schema": { "type": "string" },
        "role": { "type": "string" },
        "coreCompatibility": { "type": "string" },
        "operations": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/databaseOperation" }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": { "required": { "type": "boolean" }, "strategy": { "type": "string" } }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["onDisable", "onUninstall"],
          "properties": {
            "onDisable": { "enum": ["retain"] },
            "onUninstall": { "enum": ["retain", "delete", "export"] },
            "days": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "databaseOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statementVersion", "kind", "path", "digest", "parameters", "columns", "timeoutMs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statementVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "kind": { "enum": ["query", "execute"] },
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/digest" },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "field", "kind", "nullable", "maxBytes"],
            "properties": {
              "schema": { "$ref": "#/$defs/schemaRef" },
              "field": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$" },
              "kind": { "enum": ["string", "int64", "number", "bool"] },
              "nullable": { "type": "boolean" },
              "maxBytes": { "type": "integer", "minimum": 0, "maximum": 65536 }
            }
          }
        },
        "resultSchema": { "$ref": "#/$defs/schemaRef" },
        "columns": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "nullable"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$" },
              "nullable": { "type": "boolean" }
            }
          }
        },
        "maxRows": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxAffectedRows": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "timeoutMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "query" } }, "required": ["kind"] },
          "then": {
            "required": ["resultSchema", "maxRows"],
            "not": { "required": ["maxAffectedRows"] },
            "properties": { "columns": { "minItems": 1 } }
          },
          "else": {
            "required": ["maxAffectedRows"],
            "not": { "required": ["maxRows"] },
            "oneOf": [
              {
                "properties": { "columns": { "maxItems": 0 } },
                "not": { "required": ["resultSchema"] }
              },
              {
                "required": ["resultSchema"],
                "properties": { "columns": { "minItems": 1 } }
              }
            ]
          }
        }
      ]
    },
    "cache": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "namespace", "policy"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "namespace": { "$ref": "#/$defs/id" },
          "policy": { "enum": ["private", "actor", "permission", "public"] },
          "tags": { "$ref": "#/$defs/stringArray" },
          "provider": { "type": "string" },
          "invalidators": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "services": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "action", "handler", "requestSchema", "responseSchema"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "action": { "enum": ["add", "before", "after", "wrap", "replace"] },
          "targetId": { "$ref": "#/$defs/id" },
          "handler": { "$ref": "#/$defs/nonEmpty" },
          "requestSchema": { "$ref": "#/$defs/schemaRef" },
          "responseSchema": { "$ref": "#/$defs/schemaRef" },
          "priority": { "type": "integer" }
        }
      }
    },
    "commands": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "handler", "inputSchema", "resultSchema"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "handler": { "$ref": "#/$defs/nonEmpty" },
          "permission": { "type": "string" },
          "inputSchema": { "$ref": "#/$defs/schemaRef" },
          "resultSchema": { "$ref": "#/$defs/schemaRef" },
          "description": { "type": "string" },
          "recoverySafe": { "type": "boolean" },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 5000 }
        }
      }
    },
    "adminSurfaces": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "kind", "action", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractVersion": { "$ref": "#/$defs/contract" },
          "kind": { "enum": ["navigation", "dashboard", "list_column", "list_filter", "row_action", "bulk_action", "form", "notice", "editor_panel", "detail_region", "importer", "exporter"] },
          "action": { "enum": ["add", "before", "after", "wrap", "replace", "hide", "filter"] },
          "targetId": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/nonEmpty" },
          "handler": { "type": "string" },
          "schema": { "type": "string" },
          "permission": { "type": "string" },
          "priority": { "type": "integer" }
        }
      }
    },
    "queries": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contractVersion", "entity", "planVersion", "fields", "pagination", "resultSchema", "permissionPolicy"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
