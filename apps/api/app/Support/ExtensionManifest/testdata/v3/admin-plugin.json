{
  "manifestVersion": 3,
  "id": "fixture.admin",
  "name": "Admin Surface Plugin",
  "description": "Admin list, action, form, notice, importer, and exporter fixture.",
  "url": "https://example.com/admin",
  "author": {"name": "SForum"},
  "version": "1.0.0",
  "type": "plugin",
  "sforumVersion": "^1.0.0",
  "permissionDefinitions": [
    {"key": "fixture.admin.manage", "contractVersion": "fixture.admin.manage@1", "label": {"zh-CN": "管理后台夹具", "en-US": "Manage admin fixture"}, "description": {"zh-CN": "使用夹具提供的后台界面。", "en-US": "Use the fixture admin surfaces."}, "assignmentPolicy": "host"}
  ],
  "adminSurfaces": [
    {"id": "fixture.admin.surface.navigation", "contractVersion": "fixture.admin.surface.navigation@1", "kind": "navigation", "action": "add", "placementId": "core.component.page.admin", "placementContractVersion": "sforum.component.page.admin@1", "label": "Fixture", "handler": "admin.navigation", "propsSchema": "fixture.admin.surface.navigation.props@1", "resultSchema": "fixture.admin.surface.navigation.result@1", "operation": "query", "permission": "fixture.admin.manage"},
    {"id": "fixture.admin.surface.column", "contractVersion": "fixture.admin.surface.column@1", "kind": "list_column", "action": "add", "placementId": "core.component.page.admin.users", "placementContractVersion": "sforum.component.page.admin.users@1", "label": "Score", "handler": "admin.column", "propsSchema": "fixture.admin.surface.column.props@1", "resultSchema": "fixture.admin.surface.column.result@1", "operation": "query", "permission": "fixture.admin.manage"},
    {"id": "fixture.admin.surface.import", "contractVersion": "fixture.admin.surface.import@1", "kind": "importer", "action": "add", "placementId": "core.component.page.admin.users", "placementContractVersion": "sforum.component.page.admin.users@1", "label": "Import", "handler": "admin.import", "propsSchema": "fixture.admin.surface.import.props@1", "resultSchema": "fixture.admin.surface.import.result@1", "operation": "command", "permission": "fixture.admin.manage"},
    {"id": "fixture.admin.surface.export", "contractVersion": "fixture.admin.surface.export@1", "kind": "exporter", "action": "add", "placementId": "core.component.page.admin.users", "placementContractVersion": "sforum.component.page.admin.users@1", "label": "Export", "handler": "admin.export", "propsSchema": "fixture.admin.surface.export.props@1", "resultSchema": "fixture.admin.surface.export.result@1", "operation": "query", "permission": "fixture.admin.manage"}
  ]
}
