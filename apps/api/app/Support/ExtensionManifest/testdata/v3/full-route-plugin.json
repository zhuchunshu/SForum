{
  "manifestVersion": 3,
  "id": "fixture.routes",
  "name": "Full Route Plugin",
  "description": "Every Route Registry V1 action and streaming mode.",
  "url": "https://example.com/routes",
  "author": {"name": "SForum"},
  "version": "1.0.0",
  "type": "plugin",
  "sforumVersion": "^1.0.0",
  "backend": {"entry": "backend/plugin", "rpc": "hashicorp-go-plugin", "protocolVersion": 2, "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "hostApiVersion": "sforum.host-api@2"},
  "packageFiles": [
    {"id": "fixture.routes.file.backend", "kind": "executable", "path": "backend/plugin", "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
  ],
  "routes": [
    {"id": "fixture.routes.add", "contractVersion": "fixture.routes.add@1", "action": "add", "path": "/api/fixture/routes", "methods": ["GET"], "guard": "core.guard.public", "fallback": "closed", "mode": "http", "handler": "route.add", "responseSchema": "fixture.routes.add.response@1"},
    {"id": "fixture.routes.alias", "contractVersion": "fixture.routes.alias@1", "action": "alias", "targetId": "core.route.forum.home", "path": "/fixture/home", "methods": ["GET"], "guard": "core.guard.public", "fallback": "closed", "mode": "http"},
    {"id": "fixture.routes.redirect", "contractVersion": "fixture.routes.redirect@1", "action": "redirect", "path": "/fixture/old", "methods": ["GET"], "guard": "core.guard.public", "fallback": "closed", "mode": "http", "destination": "/fixture/new"},
    {"id": "fixture.routes.rewrite", "contractVersion": "fixture.routes.rewrite@1", "action": "rewrite", "targetId": "core.route.forum.home", "path": "/fixture/rewrite", "methods": ["GET"], "guard": "core.guard.public", "fallback": "closed", "mode": "http"},
    {"id": "fixture.routes.before", "contractVersion": "fixture.routes.before@1", "action": "before", "targetId": "core.route.forum.list_topics", "path": "/api/v1/topics", "methods": ["GET"], "guard": "core.guard.login", "fallback": "closed", "mode": "http", "handler": "route.before"},
    {"id": "fixture.routes.after", "contractVersion": "fixture.routes.after@1", "action": "after", "targetId": "core.route.forum.list_topics", "path": "/api/v1/topics", "methods": ["GET"], "guard": "core.guard.login", "fallback": "closed", "mode": "http", "handler": "route.after"},
    {"id": "fixture.routes.filter", "contractVersion": "fixture.routes.filter@1", "action": "filter", "targetId": "core.route.forum.list_topics", "path": "/api/v1/topics", "methods": ["GET"], "guard": "core.guard.login", "fallback": "closed", "mode": "http", "handler": "route.filter", "responseSchema": "sforum.route.forum.list_topics.response@1"},
    {"id": "fixture.routes.wrap", "contractVersion": "fixture.routes.wrap@1", "action": "wrap", "targetId": "core.route.forum.create_topic", "path": "/api/v1/topics", "methods": ["POST"], "guard": "core.guard.login", "fallback": "closed", "mode": "http", "handler": "route.wrap", "requestSchema": "sforum.route.forum.create_topic.request@1", "responseSchema": "sforum.route.forum.create_topic.response@1"},
    {"id": "fixture.routes.replace", "contractVersion": "fixture.routes.replace@1", "action": "replace", "targetId": "core.route.forum.create_topic", "path": "/api/v1/topics", "methods": ["POST"], "guard": "core.guard.raw_request", "fallback": "readonly_core", "mode": "http", "handler": "route.replace", "requestSchema": "sforum.route.forum.create_topic.request@1", "responseSchema": "sforum.route.forum.create_topic.response@1"},
    {"id": "fixture.routes.global", "contractVersion": "fixture.routes.global@1", "action": "global_middleware", "path": "", "methods": [], "guard": "core.guard.login", "fallback": "closed", "mode": "http", "handler": "route.global", "requestSchema": "fixture.routes.global.request@1", "responseSchema": "fixture.routes.global.response@1"},
    {"id": "fixture.routes.sse", "contractVersion": "fixture.routes.sse@1", "action": "add", "path": "/api/fixture/events", "methods": ["GET"], "guard": "core.guard.login", "fallback": "closed", "mode": "sse", "handler": "route.sse", "responseSchema": "fixture.routes.sse.response@1"},
    {"id": "fixture.routes.websocket", "contractVersion": "fixture.routes.websocket@1", "action": "add", "path": "/api/fixture/socket", "methods": ["GET"], "guard": "core.guard.login", "fallback": "closed", "mode": "websocket", "handler": "route.websocket", "responseSchema": "fixture.routes.websocket.response@1"},
    {"id": "fixture.routes.multipart", "contractVersion": "fixture.routes.multipart@1", "action": "add", "path": "/api/fixture/upload", "methods": ["POST"], "guard": "core.guard.login", "fallback": "closed", "mode": "multipart", "handler": "route.multipart", "requestSchema": "fixture.routes.multipart.request@1", "responseSchema": "fixture.routes.multipart.response@1"},
    {"id": "fixture.routes.stream", "contractVersion": "fixture.routes.stream@1", "action": "add", "path": "/api/fixture/stream", "methods": ["GET"], "guard": "core.guard.login", "fallback": "closed", "mode": "stream", "handler": "route.stream", "responseSchema": "fixture.routes.stream.response@1"}
  ]
}
