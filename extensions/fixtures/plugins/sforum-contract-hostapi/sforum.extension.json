{
  "id": "sforum.contract.hostapi",
  "name": "Contract Host API Fixture",
  "description": "CI fixture plugin that exercises Host API Ping and event catalog contracts (F4.1).",
  "url": "https://github.com/zhuchunshu/sforum",
  "author": {
    "name": "SForum",
    "url": "https://github.com/zhuchunshu/sforum"
  },
  "version": "1.0.0",
  "type": "plugin",
  "sforumVersion": ">=0.1.0",
  "capabilities": ["host.api", "settings.own", "jobs.enqueue"],
  "settings": [
    {
      "key": "sforum.contract.hostapi.marker",
      "label": { "default": "Marker" },
      "description": { "default": "Fixture-only setting for GetSettings contract tests." },
      "type": "string",
      "default": "ok"
    }
  ],
  "jobs": [{ "name": "sforum.contract.hostapi.demo" }],
  "events": [
    { "name": "topic.created", "kind": "observe" },
    { "name": "topic.before_create", "kind": "filter" }
  ],
  "backend": {
    "entry": "backend/plugin",
    "rpc": "hashicorp-go-plugin",
    "protocolVersion": 1
  }
}
