{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sectionId"],
        "properties": {
          "sectionId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": "string", "maxLength": 200 },
          "fields": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
