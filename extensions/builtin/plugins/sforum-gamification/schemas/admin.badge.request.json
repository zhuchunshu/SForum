{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.gamification.route.admin.badge.request",
  "title": "Create/update badge request",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rarity": {
      "type": "string"
    },
    "rule": {
      "type": "object"
    },
    "icon": {
      "type": "string"
    },
    "grantsPoints": {
      "type": "integer"
    },
    "sort": {
      "type": "integer"
    }
  },
  "required": [
    "slug",
    "name",
    "rarity",
    "rule"
  ]
}