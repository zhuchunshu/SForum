{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.gamification.route.profile.achievements.response",
  "title": "Public badge wall",
  "type": "object",
  "properties": {
    "userId": {
      "type": "integer"
    },
    "points": {
      "type": "integer"
    },
    "level": {
      "type": "string",
      "description": "Serialized level object; TypedDocument values are primitives."
    },
    "badges": {
      "type": "string",
      "description": "Serialized badge wall array; TypedDocument values are primitives."
    }
  },
  "required": [
    "userId",
    "badges"
  ]
}
