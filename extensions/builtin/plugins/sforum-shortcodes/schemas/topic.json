{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sforum-shortcodes.topic.schema@1",
  "title": "SForum topic shortcode call value",
  "description": "Strict value for a sforumShortcodeRef node calling sforum-shortcodes.topic@1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "attrs"],
  "properties": {
    "type": { "const": "sforumShortcodeRef" },
    "attrs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion", "arguments"],
      "properties": {
        "id": { "const": "sforum-shortcodes.topic" },
        "contractVersion": { "const": "sforum-shortcodes.topic@1" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topicId"],
          "properties": {
            "topicId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
          }
        }
      }
    }
  }
}
