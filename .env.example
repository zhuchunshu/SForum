# Startup fallbacks for admin-managed site settings.
# Edit runtime values from Admin > Site Settings after the app is running.
APP_NAME=SForum
APP_ENV=development
APP_URL=http://127.0.0.1:3000
APP_LOCALE=zh-CN
SUPPORTED_LOCALES=zh-CN,en-US
LOG_LEVEL=debug

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# API 请求体硬上限。普通附件的站点/用户组/用户上限必须低于该值；预留 1 MiB 给 multipart 元数据。
HTTP_BODY_LIMIT=67108864
# 可选 Go runtime 诊断：默认关闭，只允许 loopback；内嵌 Worker 已包含在 API profile 中。
# PPROF_ENABLED=true
# PPROF_ADDR=127.0.0.1:6060
# 独立 Worker 需要单独开启并使用不同端口。
# WORKER_PPROF_ENABLED=true
# WORKER_PPROF_ADDR=127.0.0.1:6061
WEB_PORT=3000
POSTGRES_PORT=15432
REDIS_PORT=16379
# 可选：仅在使用 search.provider 插件（Meilisearch）时需要
# MEILI_PORT=17700
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

POSTGRES_DB=sforum
POSTGRES_USER=sforum
POSTGRES_PASSWORD=sforum
DATABASE_URL=postgres://sforum:sforum@127.0.0.1:15432/sforum?sslmode=disable
MIGRATE_ON_STARTUP=true
# 连接池：development 默认 5（API/worker）/ Redis pool 8；production 默认 10 / 20。
# 需要覆盖时再取消注释：
# DATABASE_MAX_CONNS=10
# WORKER_DATABASE_MAX_CONNS=10
EMBED_WORKER_IN_API=true
WORKER_SHUTDOWN_TIMEOUT=30s

# River 队列：development 默认合计 7 workers（1+2+1+1+1+1）；production 默认 30。
# 显式设置会覆盖环境默认档：
# JOB_QUEUE_CRITICAL_WORKERS=4
# JOB_QUEUE_DEFAULT_WORKERS=8
# JOB_QUEUE_SEARCH_WORKERS=6
# JOB_QUEUE_MAIL_WORKERS=4
# JOB_QUEUE_NOTIFICATIONS_WORKERS=6
# JOB_QUEUE_MAINTENANCE_WORKERS=2

REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=sforum-dev-redis

# Startup fallbacks for the admin-managed verification tab.
HUMAN_VERIFICATION_PROVIDER=disabled
ALTCHA_SECRET=sforum-dev-altcha-secret
ALTCHA_CHALLENGE_TTL=10m
ALTCHA_COST=1000

EXTENSION_ROOT=../../storage/extensions
BUILTIN_EXTENSION_ROOT=../../extensions/builtin
# 可选，逗号分隔。每个根目录包含 plugins/ 和/或 themes/；Host 只扫描并保存惰性快照。
# EXTERNAL_EXTENSION_ROOTS=/absolute/path/to/sforum-plugins
SFORUM_V3_TRUST_CHALLENGES=false
SFORUM_V3_TRUST_CHALLENGE_TTL=5m
SFORUM_V3_PUBLIC_L2=false
MARKETPLACE_ED25519_PUBLIC_KEY_HEX=
MARKETPLACE_ED25519_KEY_ID=marketplace-primary

# 可选搜索引擎（非 core）。可通过 EXTERNAL_EXTENSION_ROOTS 扫描独立插件仓库后配置：
# MEILI_HOST=http://127.0.0.1:17700
# MEILI_MASTER_KEY=sforum-dev-meili-key

NUXT_PUBLIC_API_BASE_URL=/api/v1
NUXT_API_INTERNAL_BASE_URL=http://127.0.0.1:8080/api/v1
NUXT_PUBLIC_ADMIN_ROUTE_PREFIX=/control-panel
