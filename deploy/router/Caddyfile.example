# Managed by upgrade.sh. The committed example documents the stable ingress;
# deploy/runtime/Caddyfile is generated locally and intentionally gitignored.
:3000 {
	header X-SForum-Active-Slot blue
	# 公开只读资产：QQ 内置浏览器（X5 云加速）、CDN 换源后仍要能加载。
	# 应用侧已发同名头，这里是 ingress 冗余，避免中间层抹掉响应头。
	@cors_assets path /_nuxt/* /_sforum/*
	header @cors_assets {
		Access-Control-Allow-Origin "*"
		Timing-Allow-Origin "*"
		Cross-Origin-Resource-Policy "cross-origin"
	}
	reverse_proxy web-blue:3000
}

:18080 {
	header X-SForum-Active-Slot blue
	reverse_proxy api-blue:8080
}
