{$APP_DOMAIN} {
	encode zstd gzip

	# H4：浏览器层安全响应头。
	header {
		# 强制 HTTPS（生产域名），预防降级攻击。
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 阻止 MIME 嗅探（与 API 侧附件 nosniff 呼应）。
		X-Content-Type-Options "nosniff"
		# 禁止被任意站点嵌入框架，防点击劫持。
		X-Frame-Options "DENY"
		# 仅在同源请求中发送 Referer，避免泄漏完整 URL 到第三方。
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# 反代到 Nuxt：Caddy 默认会维护 X-Forwarded-For / X-Forwarded-Proto。
	# 若前面还有 Cloudflare 等 CDN，请在 API 的 TRUSTED_PROXIES 中列入 Caddy
	# 所在网段（以及 CDN 出口），以便 clientip 剥掉代理链拿到真实客户端 IP。
	reverse_proxy 127.0.0.1:{$WEB_PORT:3000} {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
