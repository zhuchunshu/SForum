{$APP_DOMAIN} {
	encode zstd gzip

	# H4：浏览器层安全响应头。
	header {
		# 强制 HTTPS（生产域名），预防降级攻击。
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 阻止 MIME 嗅探（与 API 侧附件 nosniff 呼应）。
		X-Content-Type-Options "nosniff"
		# 禁止被任意站点嵌入框架，防点击劫持。
		X-Frame-Options "DENY"
		# 仅在同源请求中发送 Referer，避免泄漏完整 URL 到第三方。
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Nitro 的 HTTP sendProxy 不接管 Upgrade。生产 WebSocket 直接进入 Host
	# API，仍由 Go route ingress、Host guards、Safe Mode 和 Dispatcher 授权。
	# vite-hmr 是 Host 保留的开发子协议，继续交给 Nuxt，避免本配置用于本地
	# 调试时截断 HMR。未知 Upgrade 由 Go 返回 404，不回落到 Nuxt。
	route {
		@host_api_websocket {
			header_regexp connection_upgrade Connection (?i)(^|.*,\s*)upgrade(\s*,.*|$)
			header_regexp websocket_upgrade Upgrade (?i)^websocket$
			not header Sec-WebSocket-Protocol *vite-hmr*
		}

		reverse_proxy @host_api_websocket 127.0.0.1:{$API_PORT:18080} {
			# Caddy 默认保留原始 Host、Origin、Cookie、Authorization 和 Upgrade；
			# 不在这里重写这些 Host authority 输入。
			header_up X-Real-IP {remote_host}
		}

		# 普通 HTTP 和 Nuxt HMR 仍走 Web。若前面还有 Cloudflare 等 CDN，请在
		# API 的 TRUSTED_PROXIES 中列入 Caddy 所在网段（以及 CDN 出口）。
		reverse_proxy 127.0.0.1:{$WEB_PORT:3000} {
			header_up X-Real-IP {remote_host}
		}
	}
}
